# Genesys Cloud OAuth2 credentials
# Copy this file to .env and fill in your values,
# OR pass these directly in your MCP client config (recommended).
#
# IMPORTANT: Never commit .env or your MCP config file if it contains real credentials.

# OAuth2 client ID (from Genesys Admin → IT and Integrations → OAuth)
GENESYS_CLIENT_ID=your-client-id-here

# Genesys region domain (e.g. mypurecloud.com.au, mypurecloud.com, mypurecloud.de)
GENESYS_REGION=YOUR_REGION_HERE

# GENESYS_CLIENT_SECRET is NOT required.
# The user login flow (Authorization Code + PKCE) does not use a client secret.
# Only needed if you specifically want the machine-to-machine client credentials fallback.

# Optional: override where the MCP server stores auth tokens and config
# Defaults to .sdd-summary/ relative to the project root
SDDSUM_STORAGE_PATH=/absolute/path/to/.sdd-summary

# Optional: override where lifecycle data (.summaryconfig-lifecycle/) is written
# Defaults to the current working directory
SDDSUM_LIFECYCLE_PATH=/absolute/path/to/project/root
